{
  "expo": {
    "name": "platform-mobile",
    "slug": "platform-mobile",
    "newArchEnabled": true,
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Camera access is needed to go live and be seen by your viewers.",
        "NSMicrophoneUsageDescription": "Microphone access is needed to go live and PK with other hosts."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.ryda90.platformmobile",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "RRYDA uses the camera to record your videos and to go live.",
          "microphonePermission": "RRYDA uses the microphone to record sound with your videos.",
          "recordAudioAndroid": true
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://bipo-1.onrender.com/api/v1",
      "agoraAppId": "482c0ea270be4aa8adff952ceb592bd8",
      "eas": {
        "projectId": "327e4aef-c085-4055-a4be-ef7160cdd89b"
      }
    },
    "owner": "ryda9"
  }
}
